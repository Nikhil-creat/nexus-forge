# Vercel: add these in Project Settings, Environment Variables (never commit real keys)
# Use ONE provider key; the first one found is used: Groq, Gemini, OpenRouter, OpenAI, Anthropic
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RATE_LIMIT=20
DAILY_LIMIT=400
ALLOWED_ORIGINS=
# Optional Python backend (Render): SECRET_KEY, ADMIN_PASSWORD, ORIGINS
# Optional short links (Vercel Storage, Upstash Redis). Added automatically when you connect the database:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SHARE_RATE_LIMIT=20
